<header class="site-header">
    <div class="wrap header-row">

        <div class="header-bar">

            {{> "navigation"}}

            {{!-- Logo + Donate grouped together --}}
            <div class="header-actions">
                <a class="brand" href="{{@site.url}}">
                    {{#if @site.logo}}
                        <img
                            src="{{img_url @site.logo size="s"}}"
                            alt="{{@site.title}}"
                        >
                    {{else}}
                        <span class="brand-text">
                            {{@site.title}}
                        </span>
                    {{/if}}
                </a>

                <a class="btn btn-donate" href="{{@site.url}}donate/">
                    <svg class="heart-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 21s-6.7-4.35-9.3-8.2C1 10.1 1.6 6.9 4.4 5.4c2.3-1.2 4.9-.4 6.2 1.6.4.6 1.1 1.5 1.4 2 .3-.5 1-1.4 1.4-2 1.3-2 3.9-2.8 6.2-1.6 2.8 1.5 3.4 4.7 1.7 7.4C18.7 16.65 12 21 12 21z"/>
                    </svg>
                    Donate
                </a>

                <button
                    class="menu-toggle"
                    id="menuToggle"
                    type="button"
                    aria-label="Open menu"
                    aria-expanded="false"
                >
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>

        </div>

    </div>
</header>