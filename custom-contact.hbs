{{!< default}}

{{!-- =========================================================
     CONTACT HERO
     ========================================================= --}}

<section class="contact-hero">

    <div class="wrap contact-hero-inner">

        <nav class="contact-breadcrumb" aria-label="Breadcrumb">

            <a href="{{@site.url}}">
                Home
            </a>

            <span aria-hidden="true">/</span>

            <span>
                Contact Us
            </span>

        </nav>

        <h1>
            Contact Us
        </h1>

        <p>
            We would love to hear from you. Reach out to our office in
            Morigaon, Assam.
        </p>

    </div>

</section>


{{!-- =========================================================
     CONTACT CONTENT
     ========================================================= --}}

<section class="section contact-section">

    <div class="wrap contact-grid">

        {{!-- ================= CONTACT INFORMATION ================= --}}

        <div class="contact-info">

            <div class="contact-info-card">

                <div class="contact-info-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/>
                        <circle cx="12" cy="9" r="2.5"/>
                    </svg>
                </div>

                <div>
                    <h3>Visit Us</h3>

                    <p>
                        Morigaon Civil Hospital Road, Ward No. 7,
                        PO: Morigaon, Dist. Morigaon, Assam - 782105
                    </p>
                </div>

            </div>


            <div class="contact-info-card">

                <div class="contact-info-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6.6 3.5l3 3.1-1.8 2.7c1 2.1 2.7 3.8 4.8 4.8l2.7-1.8 3.1 3c.6.6.7 1.5.2 2.2l-1.2 1.7c-.5.7-1.4 1-2.2.7-6.1-2-10.8-6.7-12.8-12.8-.3-.8 0-1.7.7-2.2L4.4 3.7c.7-.5 1.6-.4 2.2.2z"/>
                    </svg>
                </div>

                <div>
                    <h3>Call Us</h3>

                    <a href="tel:+919435164216">
                        +91 94351 64216
                    </a>
                </div>

            </div>


            <div class="contact-info-card">

                <div class="contact-info-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2"/>
                        <path d="M3 7l9 6 9-6"/>
                    </svg>
                </div>

                <div>
                    <h3>Email Us</h3>

                    <a href="mailto:mahilamehfil@yahoo.co.in">
                        mahilamehfil@yahoo.co.in
                    </a>
                </div>

            </div>


            {{!-- Facebook --}}

            <a
                class="contact-facebook"
                href="https://www.facebook.com/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14 8h3V4h-3c-3.3 0-5 1.9-5 5v3H6v4h3v4h4v-4h3l1-4h-4V9c0-.7.3-1 1-1z"/>
                </svg>
            </a>

        </div>


        {{!-- ================= CONTACT FORM ================= --}}

        <div class="contact-form-card">

            <h2>
                Send us a message
            </h2>

            <form
                class="contact-form"
                action="https://formsubmit.co/mahilamehfil@yahoo.co.in"
                method="POST"
            >

                <input
                    type="hidden"
                    name="_subject"
                    value="New Contact Form Message - Mahila Mehfil"
                >

                <input
                    type="hidden"
                    name="_captcha"
                    value="false"
                >

                <input
                    type="hidden"
                    name="_template"
                    value="table"
                >

                <div class="form-field">

                    <label for="contact-name">
                        Your name
                    </label>

                    <input
                        id="contact-name"
                        type="text"
                        name="name"
                        placeholder="Full name"
                        required
                    >

                </div>


                <div class="form-field">

                    <label for="contact-phone">
                        Phone
                    </label>

                    <div class="phone-field">

                        <span>
                            +91
                        </span>

                        <input
                            id="contact-phone"
                            type="tel"
                            name="phone"
                            placeholder="Mobile number"
                        >

                    </div>

                </div>


                <div class="form-field">

                    <label for="contact-email">
                        Email
                    </label>

                    <input
                        id="contact-email"
                        type="email"
                        name="email"
                        placeholder="you@example.com"
                        required
                    >

                </div>


                <div class="form-field">

                    <label for="contact-message">
                        Message
                    </label>

                    <textarea
                        id="contact-message"
                        name="message"
                        rows="5"
                        placeholder="How can we help?"
                        required
                    ></textarea>

                </div>


                <button
                    class="contact-submit"
                    type="submit"
                >
                    Send Message
                    <span aria-hidden="true">→</span>
                </button>

            </form>

        </div>

    </div>

</section>


{{!-- =========================================================
     GOOGLE MAP
     ========================================================= --}}

<section class="contact-map-section">

    <div class="wrap">

        <div class="contact-map">

            <iframe
                src="https://www.google.com/maps?q=Mahila%20Mehfil%2C%20Morigaon%2C%20Assam&output=embed"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Mahila Mehfil location map"
            ></iframe>

        </div>

    </div>

</section>


{{!-- =========================================================
     FINAL DONATION CTA
     ========================================================= --}}

<section class="contact-final-cta">

    <div class="wrap">

        <div class="contact-cta-box">

            <h2>
                Stand beside a woman, a child, a community.
            </h2>

            <p>
                Every contribution helps us bring care, dignity and
                opportunity to the families of Morigaon.
            </p>

            <a
                class="btn btn-donate contact-cta-button"
                href="{{@site.url}}/donate/"
            >
                Support Our Work →
            </a>

        </div>

    </div>

</section>
