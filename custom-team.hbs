{{!< default}}

{{#get "pages" filter="slug:team" as |team_members|}}
{{#foreach team_members}}
<section class="section">
<h1>{{title}}</h1>
<h6>{{content}}</h6>
</section>
{{/foreach}}
{{/get}}


{{#get "posts" filter="tag:team"  as |team_members|}}
{{#if team_members}}
<section class="section">
{{#foreach team_members}}
{{#if feature_image}}<img src="{{img_url feature_image size="m"}}" >{{/if}}
<h2>{{title}}</h2>
<h6>{{content}}</h6>
{{/foreach}}        
</section>
{{/if}}
{{/get}}