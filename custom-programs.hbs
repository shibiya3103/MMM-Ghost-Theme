{{!< default}}

<header class="page-hero"
    {{#if feature_image}}style="background-image:url('{{img_url feature_image size="xl"}}')"{{/if}}>
    <div class="wrap">
        <nav class="breadcrumb"><a href="{{@site.url}}">Home</a> / {{title}}</nav>
        <h1>{{title}}</h1>
        <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}Focused programmes for lasting change.{{/if}}</p>
    </div>
</header>

{{#if content}}
<section class="section"><div class="wrap-narrow prose">{{content}}</div></section>
{{/if}}

{{> "programs-editorial"}}

{{#get "posts" filter="tag:process" order="published_at asc" limit="20" as |steps|}}
{{#if steps}}
<section class="section process-timeline">
    <div class="wrap">
        <span class="eyebrow eyebrow-light">Our Process</span>
        <div class="timeline">
            {{#foreach steps}}
            <div class="timeline-item">
                <div class="timeline-node">0{{@number}}</div>
                <div class="timeline-card">
                    {{#primary_tag}}<span class="card-tag">{{name}}</span>{{/primary_tag}}
                    <h3>{{title}}</h3>
                    <div class="prose">{{content}}</div>
                </div>
            </div>
            {{/foreach}}
        </div>
    </div>
</section>
{{/if}}
{{/get}}

{{> "cta"}}