{{!< default}}

<section class="section error-page">
    <div class="wrap center">
        <span class="error-code">{{#if error.statusCode}}{{error.statusCode}}{{else}}404{{/if}}</span>
        <h1>Page not found</h1>
        <p>The page you're looking for doesn't exist or has moved.</p>
        <a class="btn btn-accent" href="{{@site.url}}">Back to homepage</a>
    </div>
</section>
