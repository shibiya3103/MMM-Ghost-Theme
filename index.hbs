{{!< default}}

<section class="section archive">
    <div class="wrap">
        <header class="archive-header">
            <h1>{{@site.title}}</h1>
            {{#if @site.description}}<p>{{@site.description}}</p>{{/if}}
        </header>

        <div class="grid grid-3">
            {{#foreach posts}}
                {{> "post-card"}}
            {{/foreach}}
        </div>

        {{#if pagination.next}}
        <div class="center">
            <a class="btn btn-outline" href="{{page_url pagination.next}}">Load more</a>
        </div>
        {{/if}}
    </div>
</section>
