{{!< default}}

{{!-- =========================================================
     GET INVOLVED HERO
     ========================================================= --}}

<header class="involve-page-hero">

    <div class="wrap involve-hero-inner">

        <nav class="involve-breadcrumb" aria-label="Breadcrumb">

            <a href="{{@site.url}}">
                Home
            </a>

            <span aria-hidden="true">/</span>

            <span>
                Get Involved
            </span>

        </nav>


        <h1>
            Get Involved
        </h1>


        <p>
            {{#if custom_excerpt}}
                {{custom_excerpt}}
            {{else}}
                There are many ways to be part of restoring lives
                and empowering communities.
            {{/if}}
        </p>

    </div>

</header>


{{!-- =========================================================
     GET INVOLVED CARDS
     Dynamic posts with tag: get-involved
     ========================================================= --}}

{{#get
    "posts"
    filter="tag:get-involved"
    limit="3"
    order="published_at asc"
    include="tags"
    as |ways|
}}

    {{#if ways}}

        <section class="involve-cards-section">

            <div class="wrap">

                <div class="involve-cards">

                    {{#foreach ways}}

                        <article
                            class="involve-card"
                            {{#if feature_image}}
                                style="background-image:url('{{img_url feature_image size="l"}}')"
                            {{/if}}
                        >

                            <div class="involve-card-overlay"></div>


                            <div class="involve-card-content">


                                {{!-- ================= ICON ================= --}}

                                <div class="involve-icon">

                                    {{#if @first}}

                                        {{!-- Volunteer icon --}}

                                        <svg
                                            viewBox="0 0 24 24"
                                            aria-hidden="true"
                                        >
                                            <circle
                                                cx="9"
                                                cy="8"
                                                r="3"
                                            />
                                            <path
                                                d="M3.5 19c.7-3.1 2.5-5 5.5-5s4.8 1.9 5.5 5"
                                            />
                                            <path
                                                d="M16 11c2.2 0 3.7 1.3 4.5 3.5"
                                            />
                                            <path
                                                d="M16 5.5a2.5 2.5 0 1 1 0 5"
                                            />
                                        </svg>

                                    {{else}}

                                        {{#if @last}}

                                            {{!-- Partner icon --}}

                                            <svg
                                                viewBox="0 0 24 24"
                                                aria-hidden="true"
                                            >
                                                <path
                                                    d="M10.5 13.5l3-3"
                                                />
                                                <path
                                                    d="M7.5 15.5l-1 1a3 3 0 0 1-4-4l3-3a3 3 0 0 1 4 0"
                                                />
                                                <path
                                                    d="M16.5 8.5l1-1a3 3 0 0 1 4 4l-3 3a3 3 0 0 1-4 0"
                                                />
                                            </svg>

                                        {{else}}

                                            {{!-- Donate / support icon --}}

                                            <svg
                                                viewBox="0 0 24 24"
                                                aria-hidden="true"
                                            >
                                                <path
                                                    d="M12 20s-7-4.5-9.2-8.2C1.2 9.1 2.2 5.8 5.2 5c2.1-.6 4.1.4 5.1 2.1C11.3 5.4 13.3 4.4 15.4 5c3 .8 4 4.1 2.4 6.8C16 15.5 12 20 12 20z"
                                                />
                                            </svg>

                                        {{/if}}

                                    {{/if}}

                                </div>


                                {{!-- ================= TITLE ================= --}}

                                <h2>
                                    {{title}}
                                </h2>


                                {{!-- ================= DESCRIPTION ================= --}}

                                <p>

                                    {{#if custom_excerpt}}

                                        {{custom_excerpt}}

                                    {{else}}

                                        {{excerpt words="24"}}

                                    {{/if}}

                                </p>


                                {{!-- ================= LINK ================= --}}

                                {{#if @first}}

                                    {{!-- Volunteer always goes to Contact --}}

                                    <a
                                        href="{{@site.url}}/contact/"
                                        class="involve-link"
                                    >
                                        Learn more
                                        <span aria-hidden="true">→</span>
                                    </a>

                                {{else}}

                                    {{#if @last}}

                                        <a
                                            href="{{@site.url}}/contact/"
                                            class="involve-link"
                                        >
                                            Learn more
                                            <span aria-hidden="true">→</span>
                                        </a>

                                    {{else}}

                                        <a
                                            href="{{@site.url}}/donate/"
                                            class="involve-link"
                                        >
                                            Learn more
                                            <span aria-hidden="true">→</span>
                                        </a>

                                    {{/if}}

                                {{/if}}


                            </div>

                        </article>

                    {{/foreach}}

                </div>

            </div>

        </section>

    {{else}}

        <section class="involve-empty">

            <div class="wrap">

                <p>
                    Get involved opportunities will be available soon.
                </p>

            </div>

        </section>

    {{/if}}

{{/get}}


{{!-- =========================================================
     FINAL CTA
     ========================================================= --}}

{{> "cta"}}